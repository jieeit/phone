{
    "name": "jieeit/phone",
    "description": "手机号归属地查询,手机号码归属地信息库, 522410条数据, 截止时间2026年10月22日, 目前是全网最全的数据",
    "keywords": [
        "phone", "mobile", "phone-location", "phone-attribution", 
        "手机号归属地", "手机号码归属地查询", "手机号段", "运营商查询",
        "离线查询", "php", "carrier", "china-phone", "phone-number"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "jieeit",
            "email": "1450540670@qq.com"
        }
    ],
    "require": {
        "php": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Jieeit\\Phone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jieeit\\Phone\\Tests\\": "tests/"
        }
    },
    "bin": [
        "src/bin/build-phone-data.php"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
